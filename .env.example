# RefereeOS configuration — copy to .env.local and fill in your keys
#
# Daytona SDK reads DAYTONA_API_KEY, DAYTONA_API_URL, and DAYTONA_TARGET.
# OpenAI is used inside Daytona to interpret the reproducibility receipt.

DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
# Keep false unless you explicitly want to send your local OpenAI key into Daytona.
REFEREEOS_PASS_OPENAI_KEY_TO_DAYTONA=false

# AG2 Beta LLM synthesis. Set to true and provide a key to enable.
REFEREEOS_ENABLE_AG2_LLM=false

# DeepSeek (OpenAI-compatible) — primary LLM provider for AG2 Beta
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Kimi (Moonshot) — cross-model critic for adversarial review
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Zhipu GLM (智谱) — final scorer for 3-round synthesis
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

REFEREEOS_ALLOW_LOCAL_REPRO_FALLBACK=true
REFEREEOS_OUTPUT_DIR=outputs/runs

# Optional: API key to protect the service (blank = no auth)
REFEREEOS_API_KEY=
